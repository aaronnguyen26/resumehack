{
  "manifest_version": 3,
  "key": "",
  "name": "ResumeHack — AI Career & Resume Copilot by Hacky",
  "version": "1.1.0",
  "description": "Always-on desktop AI mascot Hacky that launches ResumeHack on click, reads resume screen in Google Docs, and tracks verified tech internships.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "alarms",
    "identity",
    "debugger"
  ],
  "oauth2": {
    "client_id": "412130143258-4b1t8drhkii7hqagt7sdvd8n3qmchl8i.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/documents",
      "https://www.googleapis.com/auth/drive.readonly",
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.indeed.com/*",
        "https://*.joinhandshake.com/*"
      ],
      "js": ["content-scripts/content_scraper.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": ["content-scripts/content_docs.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content-scripts/content_mascot.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.myworkdayjobs.com/*"
      ],
      "js": ["content-scripts/content_autofill.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Hacky",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}

