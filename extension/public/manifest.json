{
  "manifest_version": 3,
  "name": "ResumeHack — AI Job & Screen Resume Copilot",
  "version": "1.0.0",
  "description": "Reads your resume screen directly in Google Docs or any webpage, tracks live GitHub internships, and tailors bullets with live ATS scoring.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.indeed.com/*",
        "https://*.joinhandshake.com/*"
      ],
      "js": ["content-scripts/content_scraper.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-scripts/content_docs.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.myworkdayjobs.com/*"
      ],
      "js": ["content-scripts/content_autofill.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open ResumeHack Copilot"
  }
}
